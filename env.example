# Required. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LOCAL_CODEX_GATEWAY_TOKEN=replace-with-a-long-random-token

# Local-only defaults
HOST=127.0.0.1
PORT=4317

# Optional override. Windows desktop installs are discovered automatically on each launch.
CODEX_BIN=codex

# Optional. Defaults to the current user's .codex directory.
CODEX_HOME=

# Semicolon-separated absolute directories that requests may use as working_directory.
# When omitted, only the directory where the gateway starts is allowed.
CODEX_ALLOWED_ROOTS=

# Safety and capacity controls
CODEX_TIMEOUT_MS=300000
CODEX_MAX_PROMPT_CHARS=200000
CODEX_CONCURRENCY=1
CODEX_MAX_QUEUED=32
CODEX_QUEUE_TIMEOUT_MS=60000
CODEX_SHUTDOWN_TIMEOUT_MS=15000

# Trace metadata only unless CODEX_TRACE_CONTENT is enabled; tokens are never stored.
# Defaults: 24 hours and at most 1000 entries. Allowed retention: 1 minute to 7 days.
CODEX_LOG_RETENTION_MS=86400000
CODEX_LOG_MAX_ENTRIES=1000

# Set to true to show each request's input, output, events, errors, and full working directory in the dashboard.
# Content is protected by the bearer token and removed by the same retention policy or a restart.
CODEX_TRACE_CONTENT=false

# Optional JSON persistence for trace metadata. Prompt/response content remains memory-only.
CODEX_TRACE_FILE=

# Keep disabled unless you explicitly need Codex to edit files.
CODEX_ALLOW_WRITES=false

# Optional fixed model. Empty means use the authenticated Codex default.
CODEX_MODEL=
